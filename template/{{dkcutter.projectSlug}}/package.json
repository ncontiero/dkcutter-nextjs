{
  "name": "{{dkcutter.projectSlug}}",
  "type": "module",
  "version": "{{dkcutter.projectVersion}}",
  "private": true,
  "packageManager": "",
  "description": "{{dkcutter.description}}",
  "author": "{{dkcutter.authorName|safe}}",
  "license": "MIT",
  "scripts": {
    "dev": "{% if dkcutter.pkgManager == 'bun' %}bun --bun {% endif %}next dev",
    "build": "{% if dkcutter.pkgManager == 'bun' %}bun --bun {% endif %}next build",
    "start": "{% if dkcutter.pkgManager == 'bun' %}bun --bun {% endif %}next start",
    "trigger:dev": "trigger dev",
    "trigger:deploy": "trigger deploy",
    "db:generate": "dotenv -e .env -- prisma generate",
    "db:push": "dotenv -e .env -- prisma db push",
    "db:migrate": "dotenv -e .env -- prisma migrate dev",
    "db:migrate:prod": "dotenv -e .env -- prisma migrate deploy",
    "db:studio": "dotenv -e .env -- prisma studio",
    "db:seed": "dotenv -e .env -- prisma db seed",
    "lint": "eslint .",
    "lint:fix": "{{ dkcutter._pkgRun }} lint {{ '-- ' if dkcutter.pkgManager == 'npm' }}--fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --reporter null",
    "test:e2e:headed": "playwright test --headed --reporter null",
    "test:e2e:debug": "playwright test --debug --reporter null",
    "test:e2e:ui": "playwright test --ui --reporter null",
    "test:e2e:report": "playwright show-report",
    "check": "{{ dkcutter._pkgRun }} lint && {{ dkcutter._pkgRun }} typecheck",
    "pre-commit": "{{ 'nano-staged' if dkcutter.useNanoStaged else 'lint-staged' }}",
    "commit-msg": "commitlint --edit",
    "prepare": "husky",
    "postinstall": "next typegen"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.2",
    "@clerk/nextjs": "7.8.4",
    "@hookform/resolvers": "5.9.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-query": "5.102.8",
    "@trigger.dev/sdk": "4.5.16",
    "@unpic/react": "1.0.2",
    "better-auth": "1.7.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.39.0",
    "next": "16.3.4",
    "next-intl": "4.14.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@ncontiero/eslint-config": "8.4.5",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/eslint-plugin-query": "5.102.8",
    "@tanstack/react-query-devtools": "5.102.8",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@trigger.dev/build": "4.5.16",
    "@types/bun": "1.4.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "10.0.5",
    "dotenv-cli": "11.0.0",
    "eslint": "10.9.1",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.4.1",
    "nano-staged": "1.0.2",
    "postcss": "8.5.26",
    "prisma": "7.10.0",
    "shadcn": "4.20.1",
    "tailwindcss": "4.3.3",
    "trigger.dev": "4.5.16",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "{{ 'nano-staged' if dkcutter.useNanoStaged else 'lint-staged' }}": {
    "*": "{{ dkcutter._pkgRun }} lint:fix"
  }
}
